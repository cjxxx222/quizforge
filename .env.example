# DeepSeek（OpenAI 兼容协议）——LLM 兜底抽取用；缺失时兜底自动关闭，失败块入隔离区
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 博查搜索 API（M3 讲解增强的检索源；缺失时讲解降级为 LLM 直讲并标注"无引用"）
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1/web-search

# 存储路径（默认在项目 data/ 下，均已 gitignore）
QUIZFORGE_DATA_DIR=data
QUIZFORGE_DB_PATH=data/quizforge.db
